# market.icexiv.top 站点内的 Universalis 反代入口。
#
# 放到 /etc/caddy/market-api.caddy，在 Caddyfile 顶层 import 该文件，
# 并在站点块内 `import market_api`：
#
#   import market-api.caddy
#   ...
#   market.icexiv.top {
#       import market_api
#       ...
#   }
#
# 注意：片段必须用 `(name) { ... }` 语法。写成 `name:` 会让 Caddyfile 后续
# import 的片段定义解析失败（实测报 "File to import not found"）。
#
# 前端构建时设置 VITE_UNIVERSALIS_BASE=/api/universalis 即可同源访问；
# handle_path 会剥掉前缀，缓存服务看到的仍然是 /api/v2/...

(market_api) {
	handle_path /api/universalis/* {
		@allowed path /api/v2/*
		handle @allowed {
			encode zstd gzip
			reverse_proxy 127.0.0.1:18090 {
				header_up Host {upstream_hostport}
				flush_interval -1
				transport http {
					versions 1.1
					keepalive 30s
				}
			}
		}
		handle {
			respond 404
		}
	}
}
