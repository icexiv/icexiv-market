# 灰度站：market-stage.icexiv.top
#
# 放在 /etc/caddy/market-stage.caddy，并在 Caddyfile 顶层 import。
# Caddyfile 里 **先 import market-api.caddy，再 import 本文件**：片段嵌套展开要求
# 被引用的片段已经定义（实测顺序反了会报 "File to import not found: market_api"）。
#
# 与正式站的区别只有静态目录与 noindex；行情接口共用 (market_api)，行为完全一致。

(market_stage) {
	encode zstd gzip
	root * /srv/market-stage.icexiv.top/www

	header {
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		# 灰度站不要被搜索引擎收录，避免和正式站重复
		X-Robots-Tag "noindex"
	}

	@immutable path /assets/* /items/*
	header @immutable Cache-Control "public, max-age=31536000, immutable"
	@html path / /index.html /render.html
	header @html Cache-Control "public, max-age=0, must-revalidate"

	import market_api

	handle /items/* {
		file_server
	}
	handle {
		try_files {path} /index.html
		file_server
	}
}

market-stage.icexiv.top {
	import market_stage
}
